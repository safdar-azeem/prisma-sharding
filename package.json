{
  "name": "prisma-sharding",
  "version": "0.0.4",
  "description": "Lightweight database sharding library for Prisma with connection pooling and health monitoring",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "safdar-azeem",
  "repository": "https://github.com/safdar-azeem/prisma-sharding",
  "keywords": [
    "prisma",
    "sharding",
    "database",
    "postgresql",
    "db-sharding",
    "horizontal-scaling",
    "connection-pool",
    "cli"
  ],
  "bin": {
    "prisma-sharding-migrate": "./dist/cli/migrate.js",
    "prisma-sharding-update": "./dist/cli/update.js",
    "prisma-sharding-studio": "./dist/cli/studio.js",
    "prisma-sharding-test": "./dist/cli/test.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean && tsup src/cli/migrate.ts src/cli/studio.ts src/cli/test.ts src/cli/update.ts --format cjs --outDir dist/cli --clean",
    "build:lib": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:cli": "tsup src/cli/migrate.ts src/cli/studio.ts src/cli/test.ts src/cli/update.ts --format cjs --outDir dist/cli",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build",
    "patch": "yarn version --patch && yarn publish",
    "minor": "yarn version --minor && yarn publish",
    "major": "yarn version --major && yarn publish",
    "release": "yarn build && yarn publish"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}